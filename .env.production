# Production template. Replace all placeholder secrets with values from a secret manager.

# logger
LOGGER_LEVEL = info

# app security
JWT_SECRET = replace-with-64-random-chars-jwt-secret-prod-20260612
JWT_EXPIRE = 1800
REFRESH_TOKEN_SECRET = replace-with-64-random-chars-refresh-secret-prod-20260612
REFRESH_TOKEN_EXPIRE = 2592000
COOKIE_SECRET = replace-with-64-random-chars-cookie-secret-prod-20260612
ALLOW_PUBLIC_REGISTER = false
STRICT_RBAC = true
STRICT_TENANT_CONTEXT = true
TRUST_PROXY = true
CORS_ORIGINS = https://app.example.com
PROTECTED_UPLOAD_ROOT = /var/lib/vet-os/protected-upload

# swagger must stay disabled in public production environments
SWAGGER_ENABLE = false
SWAGGER_PATH = api-docs
SWAGGER_VERSION = 1.0
SWAGGER_SERVER_URL = https://api.example.com

# db
DB_HOST = host.docker.internal
DB_PORT = 13307
DB_DATABASE = nest_admin
DB_USERNAME = app_runtime
DB_PASSWORD = replace-with-db-password-from-secret-manager
DB_SYNCHRONIZE = false
DB_LOGGING = ["error"]

# redis
REDIS_PORT = 6379
REDIS_HOST = host.docker.internal
REDIS_PASSWORD = replace-with-redis-password-from-secret-manager
REDIS_DB = 0

# smtp
SMTP_HOST = smtp.example.com
SMTP_PORT = 465
SMTP_USER = replace-with-smtp-user
SMTP_PASS = replace-with-smtp-password

IS_DEMO = false
